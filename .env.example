# Copy this file to .env and fill in your own values.
# .env is where secrets live locally -- it is NOT delivered by Claude and
# should NEVER be committed to git or shared with anyone.

FYERS_APP_ID=your_app_id_here
FYERS_SECRET_KEY=your_secret_key_here
FYERS_REDIRECT_URI=https://127.0.0.1

# This line gets filled in automatically by generate_token.py each day --
# no need to set it by hand.
FYERS_ACCESS_TOKEN=
